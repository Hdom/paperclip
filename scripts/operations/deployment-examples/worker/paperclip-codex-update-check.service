[Unit]
Description=Check official stable Codex version without promoting it
After=network-online.target
[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/paperclip-codex-update check
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paperclip-codex-update
