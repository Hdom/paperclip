#!/usr/bin/python3
"""Root maintenance: check stable Codex, stage immutable versions, promote idle, rollback.
No model, authentication, agent, network-policy or Docker configuration changes.
"""
import argparse, contextlib, datetime, fcntl, json, os, pathlib, re, shutil, stat, subprocess, tempfile, urllib.request, uuid
ROOT=pathlib.Path('/opt/paperclip-codex')
STATE=pathlib.Path('/var/lib/paperclip-codex-update')
SELECTOR=pathlib.Path('/usr/local/bin/codex')
LEGACY=pathlib.Path('/usr/local/lib/node_modules/@openai/codex/bin/codex.js')
EXEC_LOCK=pathlib.Path('/var/lib/paperclip-worker/codex.lock')
VERSION=re.compile(r'(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)\Z')
ENV={'PATH':'/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin','HOME':str(STATE),'NPM_CONFIG_USERCONFIG':'/dev/null','NPM_CONFIG_GLOBALCONFIG':str(STATE/'empty-global.npmrc')}
class NoRedirect(urllib.request.HTTPRedirectHandler):
 def redirect_request(self,*args,**kwargs):raise RuntimeError('Registry redirect refused')
def safe_dir(p):
 if not p.exists():p.mkdir(mode=0o755)
 s=p.lstat()
 if p.is_symlink() or not stat.S_ISDIR(s.st_mode) or s.st_uid!=0 or s.st_mode&0o022:raise RuntimeError('Unsafe maintenance directory')
def emit(data):print(json.dumps(data,sort_keys=True))
def save(name,data):
 p=STATE/name;t=p.with_name(p.name+'.'+uuid.uuid4().hex)
 with t.open('x',encoding='utf8') as f:os.chmod(t,0o600);json.dump(data,f,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
 os.replace(t,p)
def metadata(version='latest'):
 if version!='latest' and not VERSION.fullmatch(version):raise RuntimeError('Only stable numeric versions are allowed')
 with urllib.request.build_opener(NoRedirect()).open('https://registry.npmjs.org/@openai%2fcodex/'+version,timeout=20) as r:
  raw=r.read(2*1024*1024+1)
 if len(raw)>2*1024*1024:raise RuntimeError('Registry metadata too large')
 data=json.loads(raw);v=data.get('version','')
 if data.get('name')!='@openai/codex' or not VERSION.fullmatch(v) or (version!='latest' and v!=version):raise RuntimeError('Unexpected package identity')
 if data.get('dist',{}).get('tarball')!='https://registry.npmjs.org/@openai/codex/-/codex-'+v+'.tgz' or not data.get('dist',{}).get('integrity','').startswith('sha512-'):raise RuntimeError('Unexpected registry artifact')
 return data
def allowed_target(p):
 p=pathlib.Path(p)
 if p==LEGACY:return p
 try:rel=p.relative_to(ROOT/'versions')
 except ValueError:raise RuntimeError('Selector target outside owned versions')
 if len(rel.parts)!=3 or not VERSION.fullmatch(rel.parts[0]) or rel.parts[1:]!=('bin','codex'):raise RuntimeError('Invalid version selector')
 return p
def selected():
 if not SELECTOR.is_symlink():raise RuntimeError('Existing Codex selector must be a symlink')
 p=pathlib.Path(os.readlink(SELECTOR));p=p if p.is_absolute() else SELECTOR.parent/p
 return allowed_target(pathlib.Path(os.path.normpath(str(p))))
def probe(p):
 p=allowed_target(p)
 with tempfile.TemporaryDirectory(prefix='paperclip-codex-probe-') as tmp:
  os.chown(tmp,1000,1000)
  env=['/usr/sbin/runuser','-u','worker','--','/usr/bin/env','-i','PATH=/usr/local/bin:/usr/bin:/bin','HOME='+tmp,'CODEX_HOME='+tmp+'/codex',str(p)]
  r=subprocess.run(env+['--version'],capture_output=True,text=True,timeout=20,env=ENV)
  if r.returncode:raise RuntimeError('Codex version probe failed')
  m=re.search(r'codex-cli (\d+\.\d+\.\d+)',r.stdout)
  if not m:raise RuntimeError('Unexpected Codex version output')
  h=subprocess.run(env+['exec','--help'],capture_output=True,text=True,timeout=20,env=ENV)
  if h.returncode or any(flag not in h.stdout for flag in ['--json','--model','--skip-git-repo-check']):raise RuntimeError('Required Paperclip CLI flags unavailable')
  return m.group(1)
@contextlib.contextmanager
def execution_lock():
 fd=os.open(EXEC_LOCK,os.O_RDWR|os.O_NOFOLLOW)
 try:
  if not stat.S_ISREG(os.fstat(fd).st_mode):raise RuntimeError('Execution lock is not a regular file')
  try:fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
  except BlockingIOError:raise RuntimeError('Worker busy: executable promotion deferred; active work untouched')
  yield
 finally:os.close(fd)
def select(p):
 p=allowed_target(p);tmp=SELECTOR.with_name('.codex-select-'+uuid.uuid4().hex)
 os.symlink(str(p),tmp)
 try:os.replace(tmp,SELECTOR)
 finally:
  if tmp.is_symlink():tmp.unlink()
def rollback_previous(before,now):
 # Recovery must never depend on executing the possibly broken active binary.
 pending=STATE/'selection-pending.json'
 saved=json.loads((STATE/'selection.json').read_text()) if (STATE/'selection.json').exists() else None
 if pending.exists():
  candidate=json.loads(pending.read_text())
  if candidate.get('phase')=='prepared' and candidate.get('target')==str(before):saved=candidate
 if not saved or saved.get('target')!=str(before) or saved.get('phase') not in ('verified','verified_after_restart','prepared'):
  raise RuntimeError('Current selector does not match a recorded rollback source')
 target=allowed_target(saved['previousTarget'])
 if target==before:raise RuntimeError('Rollback target is already selected')
 with execution_lock():
  if selected()!=before:raise RuntimeError('Executable selector changed before rollback')
  wanted=probe(target)
  record={'atUtc':now,'action':'rollback','phase':'prepared','previousTarget':str(before),
          'previousVersion':saved.get('targetVersion'),'previousVersionSource':'selection_journal_not_active_probe',
          'target':str(target),'targetVersion':wanted}
  save('selection-pending.json',record);select(target)
  try:
   if probe(target)!=wanted:raise RuntimeError('Rollback executable failed validation')
  except BaseException:select(before);raise
  record['phase']='verified';save('selection.json',record);save('selection-pending.json',record);emit(record)
def stage(data):
 v=data['version'];dest=ROOT/'versions'/v
 if dest.exists():
  safe_dir(dest)
  if probe(dest/'bin/codex')!=v:raise RuntimeError('Existing version directory disagrees')
  return dest/'bin/codex'
 if shutil.disk_usage(ROOT).free<2*1024**3:raise RuntimeError('Insufficient disk headroom')
 staging=pathlib.Path(tempfile.mkdtemp(prefix='.stage-',dir=ROOT/'versions'));os.chmod(staging,0o755)
 try:
  args=['/usr/local/bin/npm','install','--global','--prefix',str(staging),'--registry','https://registry.npmjs.org','--cache',str(STATE/'npm-cache'),'--ignore-scripts','--no-audit','--no-fund','--fetch-retries=1','@openai/codex@'+v]
  r=subprocess.run(args,capture_output=True,text=True,timeout=180,env=ENV,cwd=STATE)
  save('last-install.json',{'version':v,'exitCode':r.returncode,'stdoutTail':r.stdout[-1000:],'stderrTail':r.stderr[-3000:]})
  if r.returncode:raise RuntimeError('Pinned npm install failed; see maintenance journal, no selector changed')
  pkg=json.loads((staging/'lib/node_modules/@openai/codex/package.json').read_text())
  if pkg.get('name')!='@openai/codex' or pkg.get('version')!=v:raise RuntimeError('Installed package identity mismatch')
  for d,ds,fs in os.walk(staging,followlinks=False):
   for n in ds+fs:
    p=pathlib.Path(d,n)
    if p.is_symlink() and not p.resolve().is_relative_to(staging):raise RuntimeError('Package symlink escapes version directory')
  os.rename(staging,dest)
  if probe(dest/'bin/codex')!=v:raise RuntimeError('Staged CLI version mismatch')
  return dest/'bin/codex'
 finally:
  if staging.exists():shutil.rmtree(staging)
def main():
 if os.geteuid()!=0:raise RuntimeError('Root-only Codex maintenance')
 parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('action',choices=['check','update','rollback','status']);args=parser.parse_args()
 for p in [ROOT,ROOT/'versions',STATE,SELECTOR.parent]:safe_dir(p)
 fd=os.open(STATE/'maintenance.lock',os.O_CREAT|os.O_RDWR|os.O_NOFOLLOW,0o600)
 try:
  fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
  before=selected();now=datetime.datetime.now(datetime.timezone.utc).isoformat()
  if args.action=='rollback':
   rollback_previous(before,now);return
  installed=probe(before)
  pending=STATE/'selection-pending.json'
  if pending.exists():
   old=json.loads(pending.read_text())
   if old.get('phase')=='prepared':
    if str(before)==old['target'] and installed==old['targetVersion']:
     old['phase']='verified_after_restart';save('selection.json',old);save('selection-pending.json',old)
    elif str(before)==old['previousTarget']:
     old['phase']='not_applied';save('selection-pending.json',old)
    else:raise RuntimeError('Unresolved selector change: inspect pending promotion')
  if args.action in ('check','status'):
   result={'atUtc':now,'installedVersion':installed,'selectedPath':str(before)}
   if args.action=='check':
    data=metadata();result.update(latestStable=data['version'],updateAvailable=tuple(map(int,data['version'].split('.')))>tuple(map(int,installed.split('.'))));save('last-check.json',result)
   emit(result);return
  data=metadata();wanted=data['version']
  if tuple(map(int,wanted.split('.')))<=tuple(map(int,installed.split('.'))):emit({'atUtc':now,'installedVersion':installed,'latestStable':wanted,'changed':False});return
  target=stage(data)
  with execution_lock():
   if selected()!=before:raise RuntimeError('Executable selector changed during staging')
   # Journal recovery intent before the atomic selector replacement.
   record={'atUtc':now,'action':args.action,'phase':'prepared','previousTarget':str(before),'previousVersion':installed,'target':str(target),'targetVersion':wanted}
   save('selection-pending.json',record);select(target)
   try:
    if probe(target)!=wanted:raise RuntimeError('Selected executable failed validation')
   except BaseException:select(before);raise
   record['phase']='verified';save('selection.json',record);save('selection-pending.json',record);emit(record)
 finally:os.close(fd)
if __name__=='__main__':
 try:main()
 except Exception as e:emit({'ok':False,'error':str(e)});raise SystemExit(1)
